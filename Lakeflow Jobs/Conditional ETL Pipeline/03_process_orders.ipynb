   "source": [
    "from pyspark.sql import functions as F\n",
    "\n",
    "df = spark.table(\"lab.dev.orders_silver\")\n",
    "\n",
    "gold_df = df.withColumn(\"processed_at\", F.current_timestamp())\n",
    "\n",
    "gold_df.write \\\n",
    "    .format(\"delta\") \\\n",
    "        .mode(\"overwrite\") \\\n",
    "            .saveAsTable(\"lab.dev.orders_gold\")"
   ]
  }
